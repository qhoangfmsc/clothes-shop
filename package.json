{
  "name": "doovan-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\"",
    "predev": "node scripts/i18n.mjs sync",
    "prebuild": "node scripts/i18n.mjs sync && node scripts/i18n.mjs check && node scripts/check-conventions.mjs && node scripts/check-docs.mjs && node scripts/check-quality.mjs",
    "i18n:sync": "node scripts/i18n.mjs sync",
    "i18n:check": "node scripts/i18n.mjs check",
    "conventions:check": "node scripts/check-conventions.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:who": "node scripts/check-docs.mjs --who",
    "quality:check": "node scripts/check-quality.mjs",
    "test:progress": "node scripts/test-progress.mjs",
    "test:mutants": "node scripts/test-mutants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.0",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.15.0",
    "gsap": "^3.13.0",
    "lucide-react": "^1.23.0",
    "next": "^15.3.0",
    "next-intl": "^4.14.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "swr": "^2.4.2",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26",
    "msw": "^3.0.3",
    "postcss": "^8.5.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0-alpha.26",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
